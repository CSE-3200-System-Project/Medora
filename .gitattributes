# Captured tool output is evidence, not source. Recording it verbatim matters more than
# whitespace hygiene, so exclude it from whitespace checks rather than editing the logs.
tests/benchmarks/reports/**/*.log -whitespace
tests/benchmarks/reports/**/*.out.log -whitespace

# Linux capsule entry points must also remain LF in Windows git-archive exports.
run text eol=lf
*.sh text eol=lf
