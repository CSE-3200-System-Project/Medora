# ============================================================================
# DEPLOYMENT
# ============================================================================
APP_ENV=development

# ============================================================================
# OCR PROVIDER
# ============================================================================
# "read": Azure Document Intelligence prebuilt-read. "custom": a custom Azure
# model. "llm": provider-agnostic LLM vision path. PaddleOCR/YOLO run locally
# regardless of this setting and are the fallback when Azure is unset.
MODEL_TYPE=read

# Required only if MODEL_TYPE uses Azure. Leave both empty to run fully local
# (PaddleOCR + YOLO), which needs no credentials.
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=
AZURE_OCR_MODEL_ID=prebuilt-read
AZURE_OCR_API_VERSION=2024-11-30
AZURE_OCR_TIMEOUT_SECONDS=45.0

# ============================================================================
# YOLO REGION DETECTION (local, no credentials required)
# ============================================================================
YOLO_MODEL_PATH=models/Yolo26s/Yolo26s-prescription-5.onnx
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_RETRY_CONF_THRESHOLD=0.18
YOLO_RETRY_INPUT_SIZES=832,960
YOLO_IOU_THRESHOLD=0.45
YOLO_ORT_INTRA_THREADS=2
YOLO_ORT_INTER_THREADS=1
YOLO_MAX_REGIONS=0
GROUP_BY_YOLO_FOR_PARSING=true

# ============================================================================
# OCR REQUEST LIMITS AND LOGGING
# ============================================================================
# Raw OCR text logging is disabled by default -- see the AI privacy stack in
# the root README before enabling it.
OCR_LOG_FULL_TEXT=false
OCR_USE_FULL_IMAGE_FALLBACK=false
OCR_MAX_UPLOAD_BYTES=15728640
OCR_MAX_IMAGE_BYTES=4194304
OCR_MAX_IMAGE_DIMENSION=2600
LOG_LEVEL=INFO

# ============================================================================
# MEDICINE FUZZY MATCHING (Supabase Postgres, read-only)
# ============================================================================
# Same database as backend/.env's SUPABASE_DATABASE_URL. Set
# DISABLE_MEDICINE_MATCHING=true to skip this entirely (OCR still works
# without brand/generic fuzzy matching).
DISABLE_MEDICINE_MATCHING=true
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
